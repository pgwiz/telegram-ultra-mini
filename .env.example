# ========================================
# Telegram Ultra Mini - Environment Config
# ========================================

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=8126033137:AAEsd9EaUkSTAsk8jhvxe8pDbU_Jga9bza8
ADMIN_CHAT_ID=6684660360

# --- Storage Channel ---
# The bot forwards/uploads every track here and records message_id in Neon DB.
# Future requests are instantly delivered via copy_message.
STORAGE_CHANNEL_ID=-1003789462388

# --- Stream Extractor API ---
# Base URL for the stream extraction service (do not hardcode in code)
YTSP_API_BASE_URL=https://ytsp-api.pgwiz.cloud
YTSP_API_TIMEOUT=30
ENABLE_API_FALLBACK=true

# --- Database (Neon Serverless PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:npg_Ots3aN9RMFvb@ep-autumn-silence-b4czkrxz-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Telethon / MTProto (For files >50MB) ---
MPROTO=true
TELEGRAM_API_ID=33442448
TELEGRAM_API_HASH=9034fe51e04c4beb9835bd807dae79ee
TELEGRAM_PHONE=+254765599109
MTPROTO_SESSION_PATH=./sessions/hermes_session

# --- Downloads & Storage ---
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DL=3
AUTO_CLEANUP_TEMP=true

# --- Caching ---
ENABLE_MEMORY_CACHE=true
MEMORY_CACHE_MAXSIZE=2000
MEMORY_CACHE_TTL_SECS=3600
DB_METADATA_TTL_DAYS=7
DB_SEARCH_TTL_HOURS=24

# --- Optional API / Health Server ---
API_HOST=0.0.0.0
API_PORT=8080
ENABLE_HEALTH_SERVER=true
